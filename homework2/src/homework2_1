#include <iostream>
#include <cmath>
#include <ctime>
using namespace std;

class Polynomial;

class Term {
    friend class Polynomial;
    friend ostream& operator<<(ostream& os, const Polynomial& p);
    friend istream& operator>>(istream& is, Polynomial& p);
private:
    float coef;  // 係數
    int exp;     // 次方
};

class Polynomial {
    friend ostream& operator<<(ostream& os, const Polynomial& p);
    friend istream& operator>>(istream& is, Polynomial& p);
private:
    Term* termArray;
    int capacity;  // 陣列目前能放幾項
    int terms;     // 目前有幾項

    // 陣列滿了就開兩倍大的
    void Resize() {
        capacity = capacity * 2;
        Term* temp = new Term[capacity];
        for (int i = 0; i < terms; i++)
            temp[i] = termArray[i];
        delete[] termArray;
        termArray = temp;
    }

    // 新增一項:如果已經有相同次方就直接加上去
    void AddTerm(float c, int e) {
        for (int i = 0; i < terms; i++) {
            if (termArray[i].exp == e) {
                termArray[i].coef = termArray[i].coef + c;
                return;
            }
        }
        if (terms == capacity)
            Resize();
        termArray[terms].coef = c;
        termArray[terms].exp = e;
        terms++;
    }

    // 把次方由大排到小 (泡沫排序)
    void Sort() {
        for (int i = 0; i < terms - 1; i++) {
            for (int j = 0; j < terms - 1 - i; j++) {
                if (termArray[j].exp < termArray[j + 1].exp) {
                    Term temp = termArray[j];
                    termArray[j] = termArray[j + 1];
                    termArray[j + 1] = temp;
                }
            }
        }
    }

public:
    Polynomial() {
        capacity = 4;
        terms = 0;
        termArray = new Term[capacity];
    }

    // 因為有 new 所以要寫 copy constructor
    Polynomial(const Polynomial& p) {
        capacity = p.capacity;
        terms = p.terms;
        termArray = new Term[capacity];
        for (int i = 0; i < terms; i++)
            termArray[i] = p.termArray[i];
    }

    ~Polynomial() {
        delete[] termArray;
    }

    Polynomial& operator=(const Polynomial& p) {
        if (this != &p) {
            delete[] termArray;
            capacity = p.capacity;
            terms = p.terms;
            termArray = new Term[capacity];
            for (int i = 0; i < terms; i++)
                termArray[i] = p.termArray[i];
        }
        return *this;
    }

    // 相加
    Polynomial Add(Polynomial poly) {
        Polynomial result;
        for (int i = 0; i < terms; i++)
            result.AddTerm(termArray[i].coef, termArray[i].exp);
        for (int i = 0; i < poly.terms; i++)
            result.AddTerm(poly.termArray[i].coef, poly.termArray[i].exp);
        result.Sort();
        return result;
    }

    // 相乘
    Polynomial Mult(Polynomial poly) {
        Polynomial result;
        for (int i = 0; i < terms; i++) {
            for (int j = 0; j < poly.terms; j++) {
                float c = termArray[i].coef * poly.termArray[j].coef;
                int e = termArray[i].exp + poly.termArray[j].exp;
                result.AddTerm(c, e);
            }
        }
        result.Sort();
        return result;
    }

    // 代入 x 算值
    float Eval(float x) {
        float sum = 0;
        for (int i = 0; i < terms; i++) {
            sum = sum + termArray[i].coef * pow(x, termArray[i].exp);
        }
        return sum;
    }
};

// 輸入:先輸入項數,再輸入每一項的係數和次方
istream& operator>>(istream& is, Polynomial& p) {
    int n;
    is >> n;
    p.terms = 0;  // 先把舊的清掉
    for (int i = 0; i < n; i++) {
        float c;
        int e;
        is >> c >> e;
        p.AddTerm(c, e);
    }
    p.Sort();
    return is;
}

// 輸出
ostream& operator<<(ostream& os, const Polynomial& p) {
    bool first = true;  // 是不是第一個印出來的項
    for (int i = 0; i < p.terms; i++) {
        if (p.termArray[i].coef == 0)
            continue;  // 係數是 0 就不印

        if (!first && p.termArray[i].coef > 0)
            os << "+";
        os << p.termArray[i].coef;
        if (p.termArray[i].exp != 0)
            os << "x^" << p.termArray[i].exp;
        first = false;
    }
    if (first)
        os << 0;  // 全部都是 0
    return os;
}

int main() {
    Polynomial p1, p2;

    cout << "請輸入多項式1 (項數 係數 次方 ...): ";
    cin >> p1;
    cout << "請輸入多項式2 (項數 係數 次方 ...): ";
    cin >> p2;

    cout << "P1(x) = " << p1 << endl;
    cout << "P2(x) = " << p2 << endl;

    Polynomial sum = p1.Add(p2);
    cout << "P1 + P2 = " << sum << endl;

    Polynomial product = p1.Mult(p2);
    cout << "P1 * P2 = " << product << endl;

    float x = 2;
    cout << "P1(" << x << ") = " << p1.Eval(x) << endl;

    // 算 10000 次相乘要多久
    clock_t start = clock();
    for (int i = 0; i < 10000; i++) {
        Polynomial t = p1.Mult(p2);
    }
    clock_t end = clock();
    double ms = (double)(end - start) * 1000 / CLOCKS_PER_SEC;
    cout << "相乘 10000 次花了 " << ms << " ms" << endl;

    return 0;
}
