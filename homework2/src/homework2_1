#include <iostream>
#include <cmath>

using namespace std;

class Polynomial;

class Term {
    friend class Polynomial;
    friend ostream& operator<<(ostream& os, const Polynomial& p);
    friend istream& operator>>(istream& is, Polynomial& p);
private:
    float coef;
    int exp;
};

class Polynomial {
    friend ostream& operator<<(ostream& os, const Polynomial& p);
    friend istream& operator>>(istream& is, Polynomial& p);

private:
    Term* termArray;
    int capacity;
    int terms;

    void NewTerm(float c, int e) {
        if (c == 0.0f) return;

        for (int i = 0; i < terms; i++) {
            if (termArray[i].exp == e) {
                termArray[i].coef += c;
                if (termArray[i].coef == 0.0f) {
                    for (int j = i; j < terms - 1; j++) {
                        termArray[j] = termArray[j + 1];
                    }
                    terms--;
                }
                return;
            }
        }

        if (terms >= capacity) {
            capacity *= 2;
            Term* temp = new Term[capacity];
            for (int i = 0; i < terms; i++) {
                temp[i] = termArray[i];
            }
            delete[] termArray;
            termArray = temp;
        }

        termArray[terms].coef = c;
        termArray[terms].exp = e;
        terms++;

        for (int i = terms - 1; i > 0; i--) {
            if (termArray[i].exp > termArray[i - 1].exp) {
                Term temp = termArray[i];
                termArray[i] = termArray[i - 1];
                termArray[i - 1] = temp;
            }
            else {
                break;
            }
        }
    }

public:
    Polynomial() {
        capacity = 4;
        terms = 0;
        termArray = new Term[capacity];
    }

    Polynomial(const Polynomial& p) {
        capacity = p.capacity;
        terms = p.terms;
        termArray = new Term[capacity];
        for (int i = 0; i < terms; i++) {
            termArray[i] = p.termArray[i];
        }
    }

    ~Polynomial() {
        delete[] termArray;
    }

    Polynomial& operator=(const Polynomial& p) {
        if (this == &p) return *this;

        delete[] termArray;
        capacity = p.capacity;
        terms = p.terms;
        termArray = new Term[capacity];
        for (int i = 0; i < terms; i++) {
            termArray[i] = p.termArray[i];
        }
        return *this;
    }

    Polynomial Add(Polynomial poly) {
        Polynomial ans;
        int i = 0, j = 0;

        while (i < terms && j < poly.terms) {
            if (termArray[i].exp == poly.termArray[j].exp) {
                float sum = termArray[i].coef + poly.termArray[j].coef;
                if (sum != 0.0f) {
                    ans.NewTerm(sum, termArray[i].exp);
                }
                i++;
                j++;
            }
            else if (termArray[i].exp < poly.termArray[j].exp) {
                ans.NewTerm(poly.termArray[j].coef, poly.termArray[j].exp);
                j++;
            }
            else {
                ans.NewTerm(termArray[i].coef, termArray[i].exp);
                i++;
            }
        }

        for (; i < terms; i++) ans.NewTerm(termArray[i].coef, termArray[i].exp);
        for (; j < poly.terms; j++) ans.NewTerm(poly.termArray[j].coef, poly.termArray[j].exp);

        return ans;
    }

    Polynomial Mult(Polynomial poly) {
        Polynomial ans;
        for (int i = 0; i < terms; i++) {
            for (int j = 0; j < poly.terms; j++) {
                float c = termArray[i].coef * poly.termArray[j].coef;
                int e = termArray[i].exp + poly.termArray[j].exp;
                ans.NewTerm(c, e);
            }
        }
        return ans;
    }

    float Eval(float f) {
        float ans = 0;
        for (int i = 0; i < terms; i++) {
            ans += termArray[i].coef * static_cast<float>(pow(f, termArray[i].exp));
        }
        return ans;
    }
};

istream& operator>>(istream& is, Polynomial& p) {
    int n;
    if (!(is >> n)) return is;

    p.terms = 0;

    for (int i = 0; i < n; i++) {
        float c;
        int e;
        is >> c >> e;
        p.NewTerm(c, e);
    }
    return is;
}

ostream& operator<<(ostream& os, const Polynomial& p) {
    if (p.terms == 0) {
        os << "0";
        return os;
    }

    for (int i = 0; i < p.terms; i++) {
        float c = p.termArray[i].coef;
        int e = p.termArray[i].exp;

        if (i > 0) {
            if (c > 0) {
                os << " + ";
            }
            else {
                os << " - ";
                c = -c;
            }
        }
        else {
            if (c < 0) {
                os << "-";
                c = -c;
            }
        }

        if (e == 0) {
            os << c;
        }
        else if (e == 1) {
            if (c == 1.0f) os << "x";
            else os << c << "x";
        }
        else {
            if (c == 1.0f) os << "x^" << e;
            else os << c << "x^" << e;
        }
    }
    return os;
}

int main() {
    Polynomial A, B;

    cout << "請輸入多項式 A: ";
    cin >> A;

    cout << "請輸入多項式 B: ";
    cin >> B;

    int choice;
    while (true) {
        cout << "\n======== Polynomial 選單 ========" << endl;
        cout << "1. 顯示 A、B" << endl;
        cout << "2. A + B" << endl;
        cout << "3. A * B" << endl;
        cout << "4. 計算 A(x)" << endl;
        cout << "5. 計算 B(x)" << endl;
        cout << "6. 重新輸入 A" << endl;
        cout << "7. 重新輸入 B" << endl;
        cout << "0. 結束程式" << endl;
        cout << "選擇: ";

        if (!(cin >> choice)) break;

        if (choice == 0) {
            break;
        }

        cout << endl;

        if (choice == 1) {
            cout << "A(x) = " << A << endl;
            cout << "B(x) = " << B << endl;
        }
        else if (choice == 2) {
            cout << "A(x) = " << A << endl;
            cout << "B(x) = " << B << endl;
            Polynomial sum = A.Add(B);
            cout << "A + B = " << sum << endl;
        }
        else if (choice == 3) {
            cout << "A(x) = " << A << endl;
            cout << "B(x) = " << B << endl;
            Polynomial prod = A.Mult(B);
            cout << "A * B = " << prod << endl;
        }
        else if (choice == 4) {
            float x;
            cout << "請輸入 x 的值: ";
            cin >> x;
            cout << "A(" << x << ") = " << A.Eval(x) << endl;
        }
        else if (choice == 5) {
            float x;
            cout << "請輸入 x 的值: ";
            cin >> x;
            cout << "B(" << x << ") = " << B.Eval(x) << endl;
        }
        else if (choice == 6) {
            cout << "請輸入多項式 A: ";
            cin >> A;
        }
        else if (choice == 7) {
            cout << "請輸入多項式 B: ";
            cin >> B;
        }
    }

    return 0;
}
